# Speech-to-text is fully local/offline (whisper.cpp) and needs no key.
#
# This is OPTIONAL. It only enables the "AI punctuation/formatting" toggle in
# Settings, which runs the transcript through a cheap OpenAI chat-completion
# call to clean up punctuation/capitalization before pasting. Leave unset (or
# the placeholder below) to skip it entirely — the app works fully without it.
OPENAI_API_KEY=sk-...
